# Application
PROJECT_NAME=HookRelay
DEBUG=True
ENVIRONMENT=development
API_V1_STR=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database (asyncpg)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hookrelay
DATABASE_URL=postgresql+psycopg://postgres:Patilo%40282@localhost:5432/postgres

# Security / JWT
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Circuit Breaker Configuration
CB_FAILURE_THRESHOLD=10
CB_BASE_COOLDOWN_S=120
CB_MAX_COOLDOWN_S=1800
CB_PROBE_TTL_S=30

# Encryption Key (256-bit Fernet key for channel and forwarding secrets)
ENCRYPTION_KEY=PckmQm1AV2sdplPDj9xw4u-McScTuRU4ZwcXaoTGQmI=

# Email Outage Alerts (Resend)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# Feature Switches
FEATURE_ALERTS=True
FEATURE_TUNNEL=True
FEATURE_RULES=True

# Alert Rate Limits & Retention
ALERT_USER_HOURLY_LIMIT=30
RETENTION_DAYS=30
